# Copy to .env.local for development. Everything is optional: without these the site runs,
# the free harness works, and checkout answers "payments are not switched on".

# Public origin, used for redirects, canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://harnay.dev

# Signs license keys. Any long random string: `openssl rand -base64 48`. Changing it invalidates every key issued.
HARNAY_LICENSE_SECRET=

# Stripe. Create two recurring prices (Pro $19/month, Team $79/month) and paste their ids.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
